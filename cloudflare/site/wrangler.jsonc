{
  // Static site on Cloudflare (parallel to GitHub Pages). Publishes ONLY
  // dist/, built by scripts/build-pages.mjs — never the repository root.
  "name": "rg-minka",
  "compatibility_date": "2026-09-25",
  "account_id": "a678c2143bd64a6ef4b783aac9953e94",
  "main": "src/index.js",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Serve index.html, mobile.html, kalendars/index.html as they are named,
    // like GitHub Pages (no redirect to pretty URLs; the service worker and
    // the calendar iframe request the .html paths).
    "html_handling": "none",
    // Every request goes through src/index.js, which sets the cache and
    // safety headers (a year for ?v= files, a check for the rest).
    "run_worker_first": true
  },
  // No per-version preview URLs: every published version stays private
  // except the live one.
  "preview_urls": false,
  // The site's own address (bought 2026-09-26, Cloudflare Registrar).
  "routes": [{ "pattern": "rgapp.page", "custom_domain": true }],
  "observability": { "enabled": true }
}
