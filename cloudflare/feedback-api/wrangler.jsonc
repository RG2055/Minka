{
  "name": "minka-feedback-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "a678c2143bd64a6ef4b783aac9953e94",
  // Own address on rgapp.page; the workers.dev address stays on for apps
  // installed before the move.
  "workers_dev": true,
  "routes": [{ "pattern": "feedback.rgapp.page", "custom_domain": true }],
  // Login check: asks minka-api whether the app's bearer token is valid.
  "services": [
    { "binding": "AUTH", "service": "minka-api" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minka-feedback-db",
      "database_id": "db63f47f-8757-4399-b039-ee7181595b07",
      "migrations_dir": "migrations"
    }
  ],
  // The radiologist/resident app (/rad): same code, its own database, so its
  // mood and comments never mix with the radiographers'. Deploy: --env rad.
  "env": {
    "rad": {
      "name": "minka-feedback-rad",
      "workers_dev": true,
      "routes": [{ "pattern": "feedback-rad.rgapp.page", "custom_domain": true }],
      "services": [
        { "binding": "AUTH", "service": "minka-api" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "minka-feedback-rad-db",
          "database_id": "053bc2b8-088c-4a6f-be1c-2dd1a0401af2",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
