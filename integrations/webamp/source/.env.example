# YouTube Data API v3 browser key for the "Online Music" library node.
# Not a secret: it travels in every request. Restrict it in Google Cloud to
#   Application restriction: HTTP referrers  ->  your-domain/*  and  *.your-domain/*
#   API restriction:         YouTube Data API v3 only
# Copy to .env.local (never committed) and fill in.
VITE_YOUTUBE_API_KEY=
# A public playlist shown as WORK at startup (the "list=" value of its URL).
VITE_YOUTUBE_DEFAULT_PLAYLIST_ID=
